<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        Title="VCF Instance Recovery Orchestrator" Height="820" Width="1100" WindowState="Maximized">
    <!--
        Loaded via XamlReader.Load from Start-InstanceRecoveryUI (see the .psm1).
        There is no code-behind class, so this file deliberately has no x:Class, no inline event
        handler attributes (Click=/SelectionChanged=), and no data-binding markup on the list
        boxes. All wiring and list population happens imperatively in the PowerShell loader script.

        Visual language is modeled on VMware's Clarity design system (as seen in vSphere Client):
        dark header bar, light gray canvas, plain white cards with a bold title (no separate header
        strip), flat underline tabs. This is a visual approximation, not certified brand colors.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="HeaderBarBrush" Color="#1D2731" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0095D3" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0077AA" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="HeaderTextBrush" Color="#22313F" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="InactiveTabTextBrush" Color="#565656" />
        <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#EAF6FC" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource HeaderTextBrush}" />
        </Style>

        <!-- Plain white card with a bold title directly on it (no separate header-bar strip),
             matching Clarity's dashboard card style (e.g. "Folder Details", "Usage" panels). -->
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{TemplateBinding Header}"
                                           Foreground="{StaticResource HeaderTextBrush}"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Margin="{TemplateBinding Padding}"
                                           Padding="0,0,0,8" />
                                <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Flat hover/selected highlight instead of the default gray selection box + dotted
             focus rectangle. -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat underline tabs, blue-when-active/gray-when-inactive text, matching the
             Summary/Monitor/Configure... tab strip style. -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" Margin="0,0,16,0">
                            <ContentPresenter x:Name="TabContent" ContentSource="Header" Margin="2,6,2,8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabContent" Property="TextElement.Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="TabContent" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0" />
                                <Setter TargetName="TabContent" Property="TextElement.Foreground" Value="{StaticResource InactiveTabTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header bar, modeled on the vSphere Client dark top bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBarBrush}" Padding="18,12">
            <TextBlock Text="VCF Instance Recovery Orchestrator" Foreground="White" FontSize="16" FontWeight="SemiBold" />
        </Border>

        <!-- Left rail (30%) and console (70%) are two independent columns, not one big stacked
             column including the console, specifically so the console's size never depends on how
             tall the left rail's panes get (that coupling used to push the console off the bottom
             of the window once Steps/Variables appeared). -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <!--
                Data Source / Workload Domains / Steps / Variables, stacked top to bottom. Steps and
                Variables are collapsed until a domain is picked (see the .psm1's domain
                SelectionChanged handler). Steps show only the cmdlet name; the full command line
                with its parameters lives in the .psm1 and is never rendered here. Variable values
                come from a JSON answer file (flat {"variableName": "value", ...}) loaded via the
                button below; each entry is sent to the console as "$variableName = 'value'"
                immediately on load, so every step's Run button can just send its command line
                directly without per-step lookups.
            -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Data Source and Workload Domains share one card as tabs (rather than two
                     separate always-visible panes) to free up vertical space below. Sized Auto,
                     not a Grid share, since its content is small and fixed; giving it an equal
                     share with Steps/Variables would waste space neither of those two can spare.
                     The .psm1 switches to the Workload Domains tab automatically once a data file
                     is loaded. -->
                <GroupBox Grid.Row="0" Header="Setup" Margin="0,0,0,12">
                    <TabControl x:Name="DataSourceDomainsTabControl" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Data Source">
                            <StackPanel Margin="0,8,0,0">
                                <RadioButton x:Name="ExtractBackupRadio" Content="Extract SDDC Manager Backup" GroupName="DataSource" Margin="0,0,0,6" />
                                <RadioButton x:Name="UseExtractedDataRadio" Content="Load Extracted SDDC Data" GroupName="DataSource" IsChecked="True" Margin="0,0,0,6" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button x:Name="BrowseButton" Content="Browse..." Width="80" DockPanel.Dock="Right" />
                                    <TextBox x:Name="FilePathTextBox" IsReadOnly="True" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="StatusTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#C0392B" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="Workload Domains">
                            <ListBox x:Name="WorkloadDomainsListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" MaxHeight="160" />
                        </TabItem>
                    </TabControl>
                </GroupBox>

                <!-- Steps and Variables also share one card as tabs, for the same reason: each
                     gets the whole remaining pane's height instead of splitting it permanently,
                     since you're typically working in one or the other, not both at once. -->
                <GroupBox x:Name="StepsVariablesGroupBox" Grid.Row="1" Header="Execution" Visibility="Collapsed">
                    <TabControl x:Name="StepsVariablesTabControl" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Steps">
                            <TabControl x:Name="StepsTabControl" Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
                                <TabItem Header="Management Domain Restores">
                                    <DockPanel Margin="0,8,0,0">
                                        <Button x:Name="RunAllManagementDomainRestoresButton" Content="Run All" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                        <ListBox x:Name="ManagementDomainRestoresStepsListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </DockPanel>
                                </TabItem>
                                <TabItem Header="Recover Default Cluster">
                                    <DockPanel Margin="0,8,0,0">
                                        <Button x:Name="RunAllRecoverDefaultClusterButton" Content="Run All" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                        <ListBox x:Name="RecoverDefaultClusterStepsListBox" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="Variables">
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="LoadVariablesButton" Content="Load Variables..." DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                <TextBlock x:Name="LoadedVariablesTextBlock" DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Text="No variables loaded yet." />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="VariablesItemsPanel" />
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </GroupBox>
            </Grid>

            <!-- Embedded console -->
            <GroupBox Grid.Column="2" Header="Console">
                <term:EasyTerminalControl x:Name="Term" StartupCommandLine="pwsh.exe -NoLogo -NoExit" />
            </GroupBox>
        </Grid>
    </Grid>
</Window>
