<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        Title="VCF Instance Recovery Orchestrator" Height="800" Width="1100">
    <!--
        Loaded via XamlReader.Load from Start-InstanceRecoveryUI (see the .psm1).
        There is no code-behind class, so this file deliberately has no x:Class, no inline event
        handler attributes (Click=/SelectionChanged=), and no data-binding markup on the list
        boxes. All wiring and list population happens imperatively in the PowerShell loader script.
    -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Data source (left) + workload domains (right) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Data Source">
                <StackPanel Margin="5">
                    <RadioButton x:Name="ExtractBackupRadio" Content="Extract SDDC Manager Backup" GroupName="DataSource" Margin="0,0,0,5" />
                    <RadioButton x:Name="UseExtractedDataRadio" Content="Load Extracted SDDC Data" GroupName="DataSource" IsChecked="True" Margin="0,0,0,5" />
                    <DockPanel Margin="0,5,0,0">
                        <Button x:Name="BrowseButton" Content="Browse..." Width="80" DockPanel.Dock="Right" />
                        <TextBox x:Name="FilePathTextBox" IsReadOnly="True" Margin="0,0,5,0" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="StatusTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkRed" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Workload Domains">
                <ListBox x:Name="WorkloadDomainsListBox" Margin="5" />
            </GroupBox>
        </Grid>

        <!--
            Steps (left) + Variables (right) for the selected domain. Collapsed until a domain is
            picked (see the .psm1's domain SelectionChanged handler). Steps show only the cmdlet
            name; the full command line with its parameters lives in the .psm1 and is never
            rendered here. Variables shows only the currently active tab's own variables, rebuilt on
            tab switch (see Update-VariablesForActiveTab). Both lists are capped to roughly 10 rows
            with a scrollbar for the rest.
        -->
        <Grid Grid.Row="1" x:Name="PhasesRow" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Steps">
                <TabControl x:Name="StepsTabControl">
                    <TabItem Header="Management Domain Restores">
                        <ListBox x:Name="ManagementDomainRestoresStepsListBox" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </TabItem>
                    <TabItem Header="Recover Default Cluster">
                        <ListBox x:Name="RecoverDefaultClusterStepsListBox" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </TabItem>
                </TabControl>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Variables">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                    <StackPanel x:Name="VariablesPanel" Margin="5" />
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- Embedded console -->
        <GroupBox Grid.Row="2" Header="Console">
            <term:EasyTerminalControl x:Name="Term" StartupCommandLine="pwsh.exe -NoLogo -NoExit" Margin="5" />
        </GroupBox>
    </Grid>
</Window>
