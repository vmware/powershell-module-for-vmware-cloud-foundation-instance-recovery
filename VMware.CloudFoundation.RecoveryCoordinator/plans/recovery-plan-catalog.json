{
  "_comment": "Drives the Recovery Parameters pane's three combo boxes (Recovery Type / Recovery Plan / Data Source) in VCFRecoveryOrchestratorUI.xaml/.ps1. Edit this file to add a new recovery plan, relabel one, change which data sources it permits, or repoint it at a different plan/variables JSON file -- no PowerShell/XAML changes needed for any of that. A brand-new plan must still reuse one of the existing 'target' values below (each is tied to a specific piece of already-built UI plumbing); adding a genuinely new kind of target is a code change, not a JSON one.",
  "recoveryTypes": [
    {
      "id": "IBR",
      "label": "Instance Backup & Restore (IBR)"
    },
    {
      "id": "FDR",
      "label": "Fleet Disaster Recovery (FDR)",
      "engineeringOnly": true
    }
  ],
  "dataSources": [
    {
      "id": "ExtractBackup",
      "label": "Extract SDDC Manager Backup"
    },
    {
      "id": "LoadExtractedData",
      "label": "Load Extracted SDDC Data"
    }
  ],
  "_targetComment": "target is one of: managementDomain | workloadDomain | additionalCluster | fleetComponent | recoverFleet -- see Sync-RecoveryPlanSelection in the .ps1 for what each one does. Exactly one plan should claim a given target; two plans claiming the same one will fight over the same panel.",
  "_extraToggleComment": "extraToggleDefinitions defines every optional plan-specific toggle once (id + label), the same way recoveryTypes/dataSources are defined once above. A plan opts in to a toggle by listing its id + defaultChecked under its own extraToggles array; the toggle's id doubles as the variable name injected into step-condition evaluation and is excluded from that plan's persisted answers file.",
  "extraToggleDefinitions": [
    {
      "id": "originalVcfInstallerAvailable",
      "label": "Original VCF Installer Available"
    }
  ],
  "recoveryPlans": [
    {
      "id": "ManagementDomain",
      "label": "Management Domain Recovery",
      "recoveryType": "IBR",
      "target": "managementDomain",
      "default": true,
      "planFolder": "ibr",
      "planFile": "management-domain-recovery-plan.json",
      "variablesFile": "management-domain-recovery-variables.json",
      "dataSources": [
        "ExtractBackup",
        "LoadExtractedData"
      ],
      "defaultDataSource": "ExtractBackup",
      "selectionList": "domains",
      "domainFilter": "MANAGEMENT",
      "tabHeaderLabel": "Management Domain"
    },
    {
      "id": "FleetComponent",
      "label": "Fleet Component Recovery",
      "recoveryType": "IBR",
      "target": "fleetComponent",
      "engineeringOnly": false,
      "planFolder": "ibr",
      "planFile": "fleet-component-recovery-plan.json",
      "variablesFile": "fleet-component-recovery-variables.json",
      "dataSources": [
        "LoadExtractedData"
      ],
      "defaultDataSource": "LoadExtractedData",
      "selectionList": "none",
      "extraToggles": [
        {
          "id": "originalVcfInstallerAvailable",
          "defaultChecked": true
        }
      ]
    },
    {
      "id": "WorkloadDomain",
      "label": "Workload Domain Recovery",
      "recoveryType": "IBR",
      "target": "workloadDomain",
      "planFolder": "ibr",
      "planFile": "workload-domain-recovery-plan.json",
      "variablesFile": "workload-domain-recovery-variables.json",
      "dataSources": [
        "LoadExtractedData"
      ],
      "defaultDataSource": "LoadExtractedData",
      "selectionList": "domains",
      "domainFilter": "NOT_MANAGEMENT",
      "tabHeaderLabel": "Workload Domains"
    },
    {
      "id": "AdditionalCluster",
      "label": "Additional Cluster Recovery",
      "recoveryType": "IBR",
      "target": "additionalCluster",
      "planFolder": "ibr",
      "planFile": "additional-cluster-recovery-plan.json",
      "variablesFile": "additional-cluster-recovery-variables.json",
      "dataSources": [
        "LoadExtractedData"
      ],
      "defaultDataSource": "LoadExtractedData",
      "selectionList": "clusters"
    },
    {
      "id": "RecoverFleet",
      "label": "Recover Fleet",
      "recoveryType": "FDR",
      "target": "recoverFleet",
      "default": true,
      "engineeringOnly": true,
      "planFolder": "fdr",
      "planFile": "fdr-failover-plan.json",
      "variablesFile": "fdr-failover-variables.json",
      "dataSources": [],
      "selectionList": "none"
    }
  ]
}
