<Window x:Class="InstanceRecoveryOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
        Title="VCF Instance Recovery Orchestrator" Height="800" Width="1100">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Data source (left) + workload domains (right) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Data Source">
                <StackPanel Margin="5">
                    <RadioButton x:Name="ExtractBackupRadio" Content="Extract a backup file" GroupName="DataSource" Margin="0,0,0,5" />
                    <RadioButton x:Name="UseExtractedDataRadio" Content="Start with existing extracted data" GroupName="DataSource" IsChecked="True" Margin="0,0,0,5" />
                    <DockPanel Margin="0,5,0,0">
                        <Button x:Name="BrowseButton" Content="Browse..." Width="80" DockPanel.Dock="Right" Click="BrowseButton_Click" />
                        <TextBox x:Name="FilePathTextBox" IsReadOnly="True" Margin="0,0,5,0" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="StatusTextBlock" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="DarkRed" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Workload Domains">
                <ListBox x:Name="WorkloadDomainsListBox" Margin="5" DisplayMemberPath="Display" SelectionChanged="WorkloadDomainsListBox_SelectionChanged" />
            </GroupBox>
        </Grid>

        <!-- Steps for the selected domain -->
        <GroupBox Grid.Row="1" Header="Steps" Margin="0,0,0,10" MinHeight="120">
            <ListBox x:Name="StepsListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,3,4,3">
                            <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Content="Run" Width="60" Margin="8,0,0,0" DockPanel.Dock="Right" Click="RunStep_Click" Tag="{Binding}" />
                            <TextBlock Text="{Binding CommandLine}" VerticalAlignment="Center" FontFamily="Consolas" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <!-- Embedded console -->
        <GroupBox Grid.Row="2" Header="Console">
            <term:EasyTerminalControl x:Name="Term" StartupCommandLine="pwsh.exe -NoLogo -NoExit" Margin="5" />
        </GroupBox>
    </Grid>
</Window>
